# MNE_Brain Release 2 Environment Template
# Credentials are loaded locally via python-dotenv. Put real values in ignored .env, never here.
MNE_OWNER_USERNAME=
# Generate this value with: python scripts/configure_owner_login.py
MNE_OWNER_PASSWORD_HASH=

# LLM Provider Configuration
LLM_PROVIDER=local_fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434
DEEPSEEK_API_KEY=

# Local .env may use opaque references or local credential values. Keep this example blank.
FORTIGATE_CREDENTIAL_REF=
FORTIGATE_SSH_PORT=22
MNE_FORTIGATE_CREDENTIAL_ENV_FILE=
MNE_CREDENTIAL_ENV_FILE=
MNE_FORTIGATE_HOST_KEY=
MNE_FORTIGATE_USERNAME_KEY=
MNE_FORTIGATE_PASSWORD_KEY=
MNE_FORTIGATE_SSH_HOSTKEY=
# P7 identity pins are local-only. Add one variable per exact device; never commit a first-use observation as trusted.
MNE_CISCO_SSH_HOSTKEY=
MNE_FTD_SSH_HOSTKEY=
MNE_LINUX_SSH_HOSTKEY=
MNE_F5_CERT_SHA256=
MNE_FMC_TLS_CERT_SHA256=
MNE_VCENTER_TLS_CERT_SHA256=
MNE_ESXI_CERT_SHA256=
MNE_SWITCH_TULKARM_HOST=
MNE_SWITCH_TULKARM_USERNAME=
MNE_SWITCH_TULKARM_PASSWORD=
MNE_SWITCH_TULKARM_SSH_HOSTKEY=
MNE_ROUTER_TULKARM_HOST=
MNE_ROUTER_TULKARM_USERNAME=
MNE_ROUTER_TULKARM_PASSWORD=
MNE_ROUTER_TULKARM_SSH_HOSTKEY=
CISCO_CREDENTIAL_REF=
CISCO_SSH_PORT=22
VMWARE_CREDENTIAL_REF=
VMWARE_PORT=443
CISCO_FMC_CREDENTIAL_REF=
CISCO_FMC_HTTPS_PORT=443
CISCO_FTD_CREDENTIAL_REF=
CISCO_FTD_SSH_PORT=22
F5_CREDENTIAL_REF=
F5_HTTPS_PORT=443
WINDOWS_IDENTITY_CREDENTIAL_REF=
WINDOWS_WINRM_PORT=5986
EXCHANGE_CREDENTIAL_REF=
EXCHANGE_POWERSHELL_PORT=5986
STORAGE_SNMP_CREDENTIAL_REF=
VEEAM_CREDENTIAL_REF=
WEB_APPLICATION_CREDENTIAL_REF=
WEB_APPLICATION_PORT=443
LINUX_CREDENTIAL_REF=
LINUX_SSH_PORT=22
PRINTER_SNMP_CREDENTIAL_REF=
SNMP_PORT=161
SNMPV3_ENGINE_ID=

# Permanent P7 SSH bindings use <MNE_DEVICE_PREFIX>_SSH_HOSTKEY.
# HTTPS management bindings use <MNE_DEVICE_PREFIX>_TLS_CERT_SHA256.
# Values belong only in the ignored local credential environment file.

# P10 real writes always use credentials separate from P7 reads. Repeat these
# three variables for each exact P7 env prefix (including individual branches).
# The reference must begin with secretref:// and all values remain local/ignored.
MNE_FORTIGATE_WRITE_CREDENTIAL_REF=
MNE_FORTIGATE_WRITE_USERNAME=
MNE_FORTIGATE_WRITE_PASSWORD=
MNE_F5_WRITE_CREDENTIAL_REF=
MNE_F5_WRITE_USERNAME=
MNE_F5_WRITE_PASSWORD=
MNE_FMC_WRITE_CREDENTIAL_REF=
MNE_FMC_WRITE_USERNAME=
MNE_FMC_WRITE_PASSWORD=
MNE_AD_WRITE_CREDENTIAL_REF=
MNE_AD_WRITE_USERNAME=
MNE_AD_WRITE_PASSWORD=
MNE_EXCHANGE_WRITE_CREDENTIAL_REF=
MNE_EXCHANGE_WRITE_USERNAME=
MNE_EXCHANGE_WRITE_PASSWORD=
MNE_VCENTER_WRITE_CREDENTIAL_REF=
MNE_VCENTER_WRITE_USERNAME=
MNE_VCENTER_WRITE_PASSWORD=
MNE_CISCO_WRITE_CREDENTIAL_REF=
MNE_CISCO_WRITE_USERNAME=
MNE_CISCO_WRITE_PASSWORD=
MNE_SAN_WRITE_CREDENTIAL_REF=
MNE_SAN_WRITE_USERNAME=
MNE_SAN_WRITE_PASSWORD=
MNE_LINUX_WRITE_CREDENTIAL_REF=
MNE_LINUX_WRITE_USERNAME=
MNE_LINUX_WRITE_PASSWORD=
OPENCODE_PROVIDER_ENV_REFS=
