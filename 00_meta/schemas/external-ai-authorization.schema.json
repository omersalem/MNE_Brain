{"$schema":"http://json-schema.org/draft-07/schema#","title":"P11 External AI Authorization","type":"object","additionalProperties":false,"required":["authorization_id","thread_id","provider_id","model_id","evidence_sources","data_classification","redaction_digest","context_digest","prompt_digest","estimated_context_tokens","includes_live_evidence","created_at","expires_at","authorization_digest","used"],"properties":{"authorization_id":{"type":"string","pattern":"^xauth_[A-Za-z0-9_-]{16,64}$"},"thread_id":{"type":"string","pattern":"^thr_[A-Za-z0-9_-]{16,64}$"},"provider_id":{"type":"string","pattern":"^prv_[A-Za-z0-9_-]{3,64}$"},"model_id":{"type":"string","minLength":1,"maxLength":160},"evidence_sources":{"type":"array","maxItems":100,"items":{"type":"string","maxLength":300}},"data_classification":{"enum":["PUBLIC","INTERNAL_REDACTED"]},"redaction_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"context_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"prompt_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"estimated_context_tokens":{"type":"integer","minimum":0,"maximum":10000000},"includes_live_evidence":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"authorization_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"used":{"type":"boolean"}}}
