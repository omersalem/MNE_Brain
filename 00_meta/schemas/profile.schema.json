{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mne-brain.local/schemas/profile.schema.json",
  "title": "MNE_Brain Read-Only Verification Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "connection", "read_commands", "normalization"],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "platform", "trust_level", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "platform": {"type": "string", "minLength": 1, "maxLength": 128},
        "trust_level": {"const": 5},
        "description": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "adapter_id",
        "entity_ref",
        "port_env",
        "credential_ref_env",
        "auth_method",
        "timeout_seconds",
        "max_output_bytes"
      ],
      "properties": {
        "protocol": {"type": "string", "enum": ["ssh", "rest", "powershell", "winrm", "vmware", "sql", "snmp"]},
        "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
        "entity_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "port_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
        "credential_ref_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
        "auth_method": {"const": "secret_reference"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "max_output_bytes": {"type": "integer", "minimum": 256, "maximum": 1048576}
      }
    },
    "read_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "target", "trust"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "command": {"type": "string", "minLength": 1, "maxLength": 512},
          "target": {"const": "in_memory_evidence"},
          "trust": {"const": 5}
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_file", "promote_policy", "freshness_ttl_seconds"],
      "properties": {
        "target_file": {"type": "string", "minLength": 1},
        "promote_policy": {"const": "two_stage_verification"},
        "freshness_ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      }
    }
  }
}
