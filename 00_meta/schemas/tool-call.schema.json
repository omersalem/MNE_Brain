{"$schema":"http://json-schema.org/draft-07/schema#","title":"P11 Tool Call","type":"object","additionalProperties":false,"required":["tool_call_id","thread_id","turn_id","tool_name","arguments","argument_digest","permission_mode","status","created_at"],"properties":{"tool_call_id":{"type":"string","pattern":"^tcall_[A-Za-z0-9_-]{16,64}$"},"thread_id":{"type":"string","pattern":"^thr_[A-Za-z0-9_-]{16,64}$"},"turn_id":{"type":"string","pattern":"^trn_[A-Za-z0-9_-]{16,64}$"},"tool_name":{"type":"string","pattern":"^(workspace|mne|p10|owner_direct)[.][a-z0-9_.-]+$"},"arguments":{"type":"object"},"argument_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"permission_mode":{"enum":["OWNER_DIRECT","OWNER_FULL_CONTROL","OWNER_AUTONOMOUS","ANSWER_ONLY","WORKSPACE_READ","WORKSPACE_WRITE","LIVE_READ","INFRASTRUCTURE_WRITE"]},"status":{"enum":["PROPOSED","APPROVAL_REQUIRED","APPROVED","RUNNING","COMPLETED","REJECTED","FAILED","UNCERTAIN"]},"created_at":{"type":"string","format":"date-time"}}}
