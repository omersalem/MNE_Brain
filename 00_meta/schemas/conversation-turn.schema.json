{
  "$schema": "http://json-schema.org/draft-07/schema#", "title": "P11 Conversation Turn",
  "type": "object", "additionalProperties": false,
  "required": ["turn_id", "thread_id", "provider_id", "engine_id", "model_id", "permission_mode", "status", "created_at", "updated_at", "message_ids", "external_authorization_id"],
  "properties": {
    "turn_id": {"type": "string", "pattern": "^trn_[A-Za-z0-9_-]{16,64}$"},
    "thread_id": {"type": "string", "pattern": "^thr_[A-Za-z0-9_-]{16,64}$"},
    "provider_id": {"type": "string", "pattern": "^prv_[A-Za-z0-9_-]{3,64}$"},
    "engine_id": {"enum": ["codex", "opencode", "antigravity", "gemini", "deterministic", "provider"]},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "permission_mode": {"enum": ["OWNER_DIRECT", "OWNER_FULL_CONTROL", "OWNER_AUTONOMOUS", "ANSWER_ONLY", "WORKSPACE_READ", "WORKSPACE_WRITE", "LIVE_READ", "INFRASTRUCTURE_WRITE"]},
    "status": {"enum": ["QUEUED", "RUNNING", "COMPLETED", "CANCELLED", "FAILED", "AUTHORIZATION_REQUIRED"]},
    "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"},
    "message_ids": {"type": "array", "maxItems": 1000, "items": {"type": "string", "pattern": "^msg_[A-Za-z0-9_-]{16,64}$"}},
    "external_authorization_id": {"type": ["string", "null"], "pattern": "^xauth_[A-Za-z0-9_-]{16,64}$"},
    "failure_code": {"type": "string", "maxLength": 80}
  }
}
