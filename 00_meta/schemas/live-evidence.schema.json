{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mne-brain.local/schemas/live-evidence.schema.json",
  "title": "MNE_Brain Attributable Live Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "entity_id",
    "profile_name",
    "platform",
    "source_file",
    "source",
    "evidence_status",
    "trust_level",
    "observed_at",
    "expires_at",
    "evidence_refs",
    "verification_target",
    "verification_check_id",
    "verification_outcome",
    "scope_reference",
    "transport_status",
    "content_sha256",
    "heading",
    "content"
  ],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^ev-live-[a-f0-9]{16}$"},
    "entity_id": {"type": "string", "minLength": 1},
    "profile_name": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "pattern": "^live-adapter://[a-z0-9_-]+/[a-z0-9_-]+$"},
    "source": {"const": "owner-authorized read-only transport"},
    "evidence_status": {"const": "live_verified"},
    "trust_level": {"const": 5},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "pattern": "^ev-live-[a-f0-9]{16}$"},
      "uniqueItems": true
    },
    "verification_target": {"type": "string", "minLength": 1},
    "verification_check_id": {"type": "string", "minLength": 1},
    "verification_outcome": {"const": "success"},
    "scope_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "transport_status": {"const": "SUCCESS"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "heading": {"type": "string", "minLength": 1, "maxLength": 200},
    "content": {"type": "string", "minLength": 1, "maxLength": 16384}
  }
}
