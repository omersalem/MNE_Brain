{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mne-brain.local/schemas/p8-diagnostic-catalog.schema.json",
  "title": "MNE_Brain P8 Diagnostic Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "owner_reference", "audit_mode", "retention", "reconciliations", "scenarios"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "mode": {"const": "OWNER_CONTROLLED_LIVE_TROUBLESHOOTING"},
    "owner_reference": {"const": "MNE-BRAIN-OWNER"},
    "audit_mode": {"const": "IN_MEMORY_ONLY"},
    "retention": {"const": "NONE"},
    "reconciliations": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["binding_id", "disposition", "canonical_entity_id", "canonical_promotion_allowed", "note"],
        "properties": {
          "binding_id": {"type": "string", "pattern": "^p7-[a-z0-9-]+$"},
          "disposition": {"enum": ["MATCHED_CANONICAL", "CANONICAL_UPDATE_CANDIDATE", "ADDITIONAL_OPERATIONAL_ASSET", "AMBIGUOUS_DO_NOT_PROMOTE"]},
          "canonical_entity_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
          "canonical_promotion_allowed": {"const": false},
          "note": {"type": "string", "minLength": 3, "maxLength": 240}
        }
      }
    },
    "scenarios": {
      "type": "array", "minItems": 8, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "title", "family", "symptom_keywords", "primary_bindings", "checks"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^p8-[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 100},
          "family": {"enum": ["branch_outage", "vpn", "web_publishing", "dns_ad", "exchange", "vmware", "firewall_security", "storage_backup_switching"]},
          "symptom_keywords": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 40}},
          "primary_bindings": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^p7-[a-z0-9-]+$"}},
          "checks": {
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["binding_id", "check_id", "objective", "read_only"],
              "properties": {
                "binding_id": {"type": "string", "pattern": "^(PRIMARY|p7-[a-z0-9-]+)$"},
                "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
                "objective": {"type": "string", "minLength": 4, "maxLength": 180},
                "read_only": {"const": true}
              }
            }
          }
        }
      }
    }
  }
}
