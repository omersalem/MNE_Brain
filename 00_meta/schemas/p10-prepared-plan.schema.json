{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mne-brain.local/schemas/p10-prepared-plan.schema.json",
  "title": "P10 Prepared Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "plan_digest", "owner_session_binding", "operation_id", "template_version", "platform", "protocol", "binding_id", "target", "parameters", "risk_level", "approval_kind", "command_hash", "rollback_hash", "target_identity_hash", "state_digest", "title", "operation_type", "status", "created_at", "expires_at", "single_use", "owner_reference", "approval_state", "audit_mode", "retention", "command_bundle", "rollback_bundle", "evidence_id", "pre_check_results", "post_checks", "success_conditions", "failure_conditions", "rollback_strategy", "transaction_mode", "timeout_seconds", "expected_impact", "risk_preview", "blast_radius", "possible_downtime", "worst_reasonable_failure", "intended_changes", "affected_systems", "dependencies", "backup_snapshot", "rollback_conditions", "non_rollbackable_operations", "critical_warning", "supports_dry_run", "maximum_targets", "live_connection_attempted", "persistence_attempted"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^p10-(?:rb-)?[a-f0-9]{16,20}$"},
    "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "owner_session_binding": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "template_version": {"type": "string", "minLength": 3, "maxLength": 32},
    "platform": {"type": "string", "minLength": 3, "maxLength": 64},
    "protocol": {"enum": ["ssh_cli", "winrm_powershell", "fmc_rest", "vcenter_rest"]},
    "binding_id": {"type": "string", "pattern": "^p7-[a-z0-9-]{2,79}$"},
    "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,252}$"},
    "parameters": {"type": "object"},
    "risk_level": {"type": "integer", "minimum": 1, "maximum": 4},
    "approval_kind": {"enum": ["CATALOGED", "CRITICAL", "IRREVERSIBLE"]},
    "command_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rollback_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_identity_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "operation_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
    "status": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "single_use": {"const": true},
    "owner_reference": {"const": "MNE-BRAIN-OWNER"},
    "approval_state": {"const": "OWNER_CONTROLLED"},
    "audit_mode": {"const": "IN_MEMORY_ONLY"},
    "retention": {"const": "NONE"},
    "command_bundle": {"$ref": "#/definitions/publicBundle"},
    "rollback_bundle": {"$ref": "#/definitions/publicBundle"},
    "evidence_id": {"type": "string", "minLength": 3, "maxLength": 160},
    "pre_check_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/checkResult"}},
    "post_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"}},
    "success_conditions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
    "failure_conditions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
    "rollback_strategy": {"enum": ["PREAPPROVED_AUTOMATIC_ON_DECLARED_FAILURE", "NO_SAFE_ROLLBACK"]},
    "transaction_mode": {"enum": ["SINGLE_TYPED_OPERATION", "PLATFORM_NATIVE_TRANSACTION", "EXPLICIT_ORDERED_BUNDLE"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "expected_impact": {"type": "string", "minLength": 3, "maxLength": 500},
    "risk_preview": {"type": "string", "minLength": 3, "maxLength": 1000},
    "blast_radius": {"type": "string", "minLength": 3, "maxLength": 1000},
    "possible_downtime": {"type": "string", "minLength": 3, "maxLength": 1000},
    "worst_reasonable_failure": {"type": "string", "minLength": 3, "maxLength": 1000},
    "intended_changes": {"type": "string", "minLength": 3, "maxLength": 1000},
    "affected_systems": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
    "dependencies": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "backup_snapshot": {"type": "string", "minLength": 3, "maxLength": 1000},
    "rollback_conditions": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
    "non_rollbackable_operations": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 3, "maxLength": 300}},
    "critical_warning": {"type": ["object", "null"]},
    "supports_dry_run": {"type": "boolean"},
    "maximum_targets": {"const": 1},
    "live_connection_attempted": {"const": false},
    "persistence_attempted": {"const": false},
    "rollback_of": {"type": "string", "pattern": "^p10-[a-f0-9]{20}$"},
    "rollback_contract": {"type": "object"}
  },
  "definitions": {
    "publicBundle": {
      "type": "object", "additionalProperties": false,
      "required": ["display_commands", "bundle_hash", "contains_credentials", "hidden_chaining"],
      "properties": {
        "display_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 8192}},
        "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contains_credentials": {"const": false},
        "hidden_chaining": {"const": false}
      }
    },
    "checkResult": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "passed", "read_only", "evidence_id", "observed_at"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "passed": {"type": "boolean"}, "read_only": {"const": true},
        "evidence_id": {"type": "string", "minLength": 3}, "observed_at": {"type": "string", "format": "date-time"},
        "detail": {"type": "string", "maxLength": 500}
      }
    }
  }
}
