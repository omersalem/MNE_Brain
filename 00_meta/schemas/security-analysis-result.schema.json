{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://mne-brain.org/schemas/security-analysis-result.schema.json",
  "title": "Security Analysis Result Schema",
  "description": "Structured analysis output produced by Codex or Antigravity for a security run or incident.",
  "type": "object",
  "required": [
    "analysis_id",
    "provider",
    "engine",
    "model",
    "created_at",
    "status",
    "plain_summary",
    "confidence"
  ],
  "properties": {
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_id": {
      "type": ["string", "null"]
    },
    "run_id": {
      "type": ["string", "null"]
    },
    "incident_fingerprint": {
      "type": ["string", "null"]
    },
    "provider": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["RUNNING", "COMPLETED", "PARTIAL", "FAILED"]
    },
    "plain_summary": {
      "type": "string"
    },
    "affected_systems": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "affected_users": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "affected_branches": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "affected_services": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "ranked_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hypothesis", "likelihood"],
        "properties": {
          "hypothesis": { "type": "string" },
          "likelihood": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
          "explanation": { "type": "string" }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "observations": {
      "type": "object",
      "properties": {
        "supporting": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradicting": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "recommended_diagnostics": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "immediate_actions": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "long_term_actions": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "relevant_steps": {
      "type": "object",
      "properties": {
        "cli": { "type": "array", "items": { "type": "string" } },
        "gui": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_references": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "additionalProperties": false
}
