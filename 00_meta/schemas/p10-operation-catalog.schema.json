{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mne-brain.local/schemas/p10-operation-catalog.schema.json",
  "title": "P10 Owner-Controlled Operation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phase", "approval_state", "owner_reference", "schema_templates", "families"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "phase": {"const": "P10"},
    "approval_state": {"const": "OWNER_CONTROLLED"},
    "owner_reference": {"const": "MNE-BRAIN-OWNER"},
    "schema_templates": {
      "type": "object", "additionalProperties": false, "required": ["common_parameters"],
      "properties": {"common_parameters": {"$ref": "#/definitions/parameterSchema"}}
    },
    "families": {
      "type": "array", "minItems": 7, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["family_id", "title", "operations"],
        "properties": {
          "family_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "title": {"type": "string", "minLength": 3, "maxLength": 128},
          "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/operation"}}
        }
      }
    }
  },
  "definitions": {
    "parameterSchema": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "additionalProperties", "required", "properties"],
      "properties": {
        "type": {"const": "object"},
        "additionalProperties": {"const": false},
        "required": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "properties": {"type": "object", "minProperties": 2}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "title", "platform", "operation_type", "action_variants", "template_status", "template_version", "risk_level", "allowed_bindings", "parameter_schema", "command_renderer", "command_preview", "pre_checks", "post_checks", "rollback_strategy", "rollback_renderer", "expected_impact", "prohibited_conditions", "timeout_seconds", "transaction_mode", "requires_critical_exception", "supports_dry_run", "maximum_targets"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^p10-[a-z0-9][a-z0-9-]{2,95}$"},
        "title": {"type": "string", "minLength": 3, "maxLength": 160},
        "platform": {"enum": ["fortinet_fortios", "f5_bigip", "cisco_fmc", "windows_powershell", "vmware_vcenter", "cisco_switching", "fujitsu_switching", "linux_host"]},
        "operation_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"},
        "action_variants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}},
        "template_status": {"enum": ["draft", "reviewed", "retired"]},
        "template_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "risk_level": {"type": "integer", "minimum": 1, "maximum": 4},
        "allowed_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^p7-[a-z0-9-]{2,79}$"}},
        "parameter_schema": {"$ref": "#/definitions/parameterSchema"},
        "command_renderer": {"type": "string", "pattern": "^[A-Z0-9_]{3,80}$"},
        "command_preview": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 2048}},
        "pre_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"}},
        "post_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"}},
        "rollback_strategy": {"enum": ["SEPARATE_OWNER_APPROVAL", "PLATFORM_ABORT_THEN_SEPARATE_COMMITTED_ROLLBACK", "NO_SAFE_ROLLBACK"]},
        "rollback_renderer": {"type": "string", "pattern": "^[A-Z0-9_]{3,80}$"},
        "expected_impact": {"type": "string", "minLength": 3, "maxLength": 500},
        "prohibited_conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,79}$"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "transaction_mode": {"enum": ["SINGLE_TYPED_OPERATION", "PLATFORM_NATIVE_TRANSACTION", "EXPLICIT_ORDERED_BUNDLE"]},
        "requires_critical_exception": {"type": "boolean"},
        "supports_dry_run": {"type": "boolean"},
        "maximum_targets": {"const": 1}
      }
    }
  }
}
