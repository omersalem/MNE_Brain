{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mne-brain.local/schemas/p7-device-bindings.schema.json",
  "title": "MNE_Brain P7 Credentialed Device Bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "owner_reference", "audit_mode", "retention", "bindings"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "mode": {"const": "PERMANENT_LOCAL_TRANSPORT_BINDINGS"},
    "owner_reference": {"const": "MNE-BRAIN-OWNER"},
    "audit_mode": {"const": "IN_MEMORY_ONLY"},
    "retention": {"const": "NONE"},
    "bindings": {
      "type": "array", "minItems": 1, "maxItems": 96, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["binding_id", "env_prefix", "platform", "protocol", "identity_mode", "check_id", "operation", "scope_status", "read_only"],
        "properties": {
          "binding_id": {"type": "string", "pattern": "^p7-[a-z0-9][a-z0-9-]{1,79}$"},
          "env_prefix": {"type": "string", "pattern": "^MNE_[A-Z0-9_]{2,100}$"},
          "credential_env_prefix": {"type": "string", "pattern": "^MNE_[A-Z0-9_]{2,100}$"},
          "entity_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
          "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{1,253}$"},
          "credential_ref_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
          "platform": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "protocol": {"enum": ["ssh", "winrm", "rest", "powershell", "vmware", "snmp", "tcp"]},
          "identity_mode": {"enum": ["PINNED_HOST_KEY", "PINNED_TLS_CERT", "KERBEROS_FQDN", "SNMP_ENGINE_ID", "EXACT_TARGET_ONLY"]},
          "kerberos_fqdn": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{2,253}$"},
          "endpoint_path": {"type": "string", "pattern": "^/[A-Za-z0-9_./?{}=*$-]{1,500}$"},
          "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "operation": {"type": "string", "minLength": 2, "maxLength": 1000},
          "scope_status": {"enum": ["ACTIVE", "OWNER_EXCLUDED"]},
          "read_only": {"const": true}
        }
      }
    }
  }
}
