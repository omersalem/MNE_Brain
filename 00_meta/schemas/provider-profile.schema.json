{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "P11 Provider Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_id", "provider_type", "adapter_type", "model_id", "credential_ref", "base_url", "capabilities", "limits", "classification", "enabled", "reviewed_at"],
  "properties": {
    "provider_id": {"type": "string", "pattern": "^prv_[A-Za-z0-9_-]{3,64}$"},
    "provider_type": {"enum": ["codex_app_server", "opencode", "deterministic_local", "ollama", "openai_compatible", "openai", "anthropic"]},
    "adapter_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "model_id": {"type": "string", "minLength": 1, "maxLength": 160, "not": {"pattern": "(?i)latest"}},
    "credential_ref": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{2,80}$"},
    "base_url": {"type": "string", "format": "uri", "maxLength": 500},
    "capabilities": {"$ref": "provider-capabilities.schema.json"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["context_tokens", "output_tokens", "timeout_seconds", "max_cost_usd"],
      "properties": {
        "context_tokens": {"type": "integer", "minimum": 256, "maximum": 10000000},
        "output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000}
      }
    },
    "classification": {"enum": ["LOCAL", "EXTERNAL"]},
    "enabled": {"type": "boolean"},
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
