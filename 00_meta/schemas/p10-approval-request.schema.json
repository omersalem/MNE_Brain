{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "https://mne-brain.local/schemas/p10-approval-request.schema.json",
  "title": "P10 Approval Request", "type": "object", "additionalProperties": false,
  "required": ["plan_id", "owner_reference", "approval_phrase", "csrf_token", "request_nonce"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^p10-(?:rb-)?[a-f0-9]{16,20}$"}, "owner_reference": {"const": "MNE-BRAIN-OWNER"},
    "approval_phrase": {"type": "string", "minLength": 80, "maxLength": 512}, "csrf_token": {"type": "string", "minLength": 32, "maxLength": 128},
    "request_nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"}
  }
}
