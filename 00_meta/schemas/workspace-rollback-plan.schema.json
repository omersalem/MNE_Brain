{"$schema":"http://json-schema.org/draft-07/schema#","title":"P11 Workspace Rollback Plan","type":"object","additionalProperties":false,"required":["rollback_id","source_plan_id","unified_diff","apply_direction","diff_digest","post_apply_digest","paths","created_at","expires_at","status","approval_phrase"],"properties":{"rollback_id":{"type":"string","pattern":"^wrollback_[A-Za-z0-9_-]{16,64}$"},"source_plan_id":{"type":"string","pattern":"^wplan_[A-Za-z0-9_-]{16,64}$"},"unified_diff":{"type":"string","minLength":1,"maxLength":2000000},"apply_direction":{"const":"REVERSE"},"diff_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"post_apply_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"paths":{"type":"array","minItems":1,"maxItems":200,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":500}},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"status":{"enum":["PREPARED","APPROVED","ROLLED_BACK","EXPIRED","UNCERTAIN"]},"approval_phrase":{"type":"string","minLength":20,"maxLength":300}}}
