{"$schema":"http://json-schema.org/draft-07/schema#","title":"P11 Stream Event","type":"object","additionalProperties":false,"required":["event_id","thread_id","turn_id","event_type","timestamp","provider_id","status","redacted_payload"],"properties":{"event_id":{"type":"string","pattern":"^evt_[A-Za-z0-9_-]{16,64}$"},"thread_id":{"type":"string","pattern":"^thr_[A-Za-z0-9_-]{16,64}$"},"turn_id":{"type":"string","pattern":"^trn_[A-Za-z0-9_-]{16,64}$"},"event_type":{"enum":["turn.started","investigation.planned","agent.progress","agent.plan","answer.delta","answer.final","evidence.accepted","command.started","command.output","command.completed","file.change","file.diff","tool.proposed","tool.approval_required","tool.started","tool.completed","turn.completed","turn.cancelled","turn.failed"]},"timestamp":{"type":"string","format":"date-time"},"provider_id":{"type":"string","pattern":"^prv_[A-Za-z0-9_-]{3,64}$"},"status":{"enum":["QUEUED","RUNNING","COMPLETED","CANCELLED","FAILED","APPROVAL_REQUIRED","AUTOMATIC_READ","AUTOMATIC_PREPARATION"]},"redacted_payload":{"type":"object","maxProperties":40}}}
